@model BiteWise.ViewModels.ArticleViewModels.EditArticleViewModel

@{
    ViewData["Title"] = "EditArticle";
}

<script src="https://ajax.aspnetcdn.com/ajax/jquery.validate/1.17.0/jquery.validate.min.js"></script>
<script src="https://ajax.aspnetcdn.com/ajax/jquery.validation.unobtrusive/3.2.10/jquery.validate.unobtrusive.min.js"></script>

<div>
    <div>
        <form method="get" asp-controller="User" asp-action="MyPage">
            <input class="enter_submit" type="submit" value="Назад" />
        </form>
    </div>
    <div>
        <div>
            <a style="text-decoration: none;" asp-controller="Tag" asp-action="Create"
               class="btn btn-sm btn-outline-secondary">Добавить новый тег?</a>
        </div>
        <form class="frm" method="post" asp-controller="Article" asp-action="UpdateArticle">
            @if (Model.AllTags is not null && Model.AllTags?.Count != 0)
            {
                <div class="form-group">
                    <label>Теги:</label>
                    @if (Model.AllTags is not null && Model.SelectedTagsIds is not null)
                    {
                        <div style="display: flex" class="checkbox-list">
                            @foreach (var tag in Model.AllTags)
                            {
                                @if (Model.Tags is not null && Model.Tags.Any(t => t.Id == tag.Id))
                                {
                                    <div style="margin-left: 10px" class="form-check">
                                        <input checked
                                               type="checkbox"
                                               id="tag-@tag.Id"
                                               name="SelectedTagsIds"
                                               value="@tag.Id"
                                               @(Model.SelectedTagsIds.Contains(tag.Id.ToString()) ? "checked" : "")
                                               class="form-check-input" />
                                        <label class="form-check-label" for="tag-@tag.Id">@tag.Name</label>
                                    </div>
                                }
                                else
                                    {
                                    <div style="margin-left: 10px" class="form-check">
                                        <input type="checkbox"
                                               id="tag-@tag.Id"
                                               name="SelectedTagsIds"
                                               value="@tag.Id"
                                               @(Model.SelectedTagsIds.Contains(tag.Id.ToString()) ? "checked" : "")
                                               class="form-check-input" />
                                        <label class="form-check-label" for="tag-@tag.Id">@tag.Name</label>
                                    </div>
                                    }
                                }
                        </div>
                    }
                </div>
            }
            <div style="">
                <input type="hidden" asp-for="Id" value="@Model.Id" />
            </div>
            <div style="">
                <input type="hidden" asp-for="UserEntityId" value="@Model.UserEntityId" />
            </div>
            <div style="">
                <input type="hidden" asp-for="Tags" value="@Model.Tags" />
            </div>
            <div class="mrgn">
                <input asp-for="Title" class="form-control" maxlength="65" placeholder="Тема статьи" style="width: 100%" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="mrgn">
                <textarea asp-for="Content" class="form-control" placeholder="Пишите сюда..." style="width: 100%; height: 200px"></textarea>
                <span asp-validation-for="Content" class="text-danger"></span>
            </div>
            <div class="mrgn">
                <input asp-for="Image" class="form-control" placeholder="Ссылка на иллюстрацию" />
                <span asp-validation-for="Image" class="text-danger"></span>
            </div>
            <div class="center">
                <button class="btn_submit" type="submit">Отправить</button>
            </div>
        </form>
    </div>
</div>