@using System.Security.Claims
@using BiteWise.BLL.Models
@using BiteWise.Extentions
@using BiteWise.ViewModels.CommentViewModels
@model BiteWise.ViewModels.ArticleViewModels.ArticleViewModel
@inject BiteWise.BLL.Services.UserService UserService;

@{
    ViewData["Title"] = "PublicArticle";
}

<form method="get" asp-controller="DashBoard" asp-action="Index" class="form-inline">
    <button type="submit" class="enter_submit">На главную страницу</button>
</form>

<div class="row">
    <div class="main">
        <div class="side">
            <div class="lined-block">
                <div>
                    @if (Model.Tags is not null)
                    {
                        @foreach (var tag in Model.Tags)
                        {
                            <label style="color: black; border: groove" class="badge">@tag.Name</label>
                        }
                    }
                </div>
                <div style="text-align:center;">
                <label style="font-size: 32px;">@Model.Title</label><br />
                </div>
                <div style="position: relative;
                    width: 100%;
                    height: 500px;
                    overflow: hidden;">
                    <img class="main-img" src="@Model.Image" />
                </div>
                <div style="text-align:justify;">
                <label style="background-color: white; border-radius: 10px; margin-top: 20px; padding: 10px">@Model.Content</label>
            </div>
                <div>
                    <label style="font-weight:bold">@Model.Created</label>
                </div>
            </div>
        </div>
        <div>
            <table style="margin-top: 10px; width: 100%;">
            @if (Model.Comments is not null)
                @foreach (var comment in Model.Comments)
                {
                    <tr>
                        <td style="width: 500px; border: ridge; background-color: white">@comment.Content</td>
                        <td style="border: ridge">@comment.Created</td>
                        <td style="border: ridge">@UserService.GetByIdAsync(comment.UserEntityId.ToString()).Result.UserName</td>
                        @if (User.FindFirst(ClaimTypes.NameIdentifier)?.Value == comment.UserEntityId.ToString() || User.FindAll(ClaimTypes.Role).Any(c => c.Value == "Admin" || c.Value == "Moderator"))
                        {
                                <td style="text-align: center; border: ridge">
                                    @using (Html.BeginForm("GetComment", "Comment", FormMethod.Get))
                                    {
                                        @Html.Hidden("commentId", comment.Id)
                                        <input class="btn btn-sm btn-outline-secondary" type="submit" value="Изменить комментарий" />
                                    }
                            </td>
                        }
                        @if (User.FindFirst(ClaimTypes.NameIdentifier)?.Value == comment.UserEntityId.ToString() || User.FindAll(ClaimTypes.Role).Any(c => c.Value == "Admin" || c.Value == "Moderator"))
                        {
                                <td style="text-align: center; border: ridge">
                                    @using (Html.BeginForm("DeleteComment", "Comment", FormMethod.Post))
                                    {
                                        @Html.Hidden("commentId", comment.Id)
                                        <input class="btn btn-sm btn-outline-secondary" type="submit" value="Удалить комментарий" />
                                    }
                           </td>
                        }
                    </tr>
                }
             </table>
        </div>
        <div>

@if (UserService.IsSignIn(User))
{
    <partial name="AddComment" model="@new CommentViewModel() { ArticleId = Model.Id, UserId = Guid.Parse(User.GetUserId()) }"/>

    @if (User.FindFirst(ClaimTypes.NameIdentifier)?.Value == Model.UserEntityId || User.FindAll(ClaimTypes.Role).Any(c => c.Value == "Admin" || c.Value == "Moderator"))
    {
                    <div class="mrgn center-align">
                <form asp-controller="Article" asp-action="EditArticle" asp-route-id="@Model.Id" method="get">
                       <input class="enter_submit" type="submit" value="Изменить статью" />
                </form>
        </div>
        <div class="mrgn center-align">
               @using (Html.BeginForm("DeleteArticle", "Article", FormMethod.Post))
               {
                   @Html.Hidden("id", Model.Id.ToString())
                   <input class="enter_submit" type="submit" value="Удалить статью" />
               }
        </div>
    }
}
else
{
    <div class="center-align gray-text">
                Для того, чтобы комментировать статьи - <a asp-controller="Home" asp-action="Register">зарегистрируйтесь</a> или <a asp-controller="Account" asp-action="Login">войдите</a> в аккаунт!
    </div>
}
        </div>
    </div>
</div>