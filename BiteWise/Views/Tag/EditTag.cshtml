@model BiteWise.ViewModels.TagViewModels.EditTagViewModel;

@{
    ViewData["Title"] = "EditTag";
}

<script src="https://ajax.aspnetcdn.com/ajax/jquery.validate/1.17.0/jquery.validate.min.js"></script>
<script src="https://ajax.aspnetcdn.com/ajax/jquery.validation.unobtrusive/3.2.10/jquery.validate.unobtrusive.min.js"></script>

<div class="block-reg background-white">
    <h3 class="center">Редактирование тега</h3>
    <form class="frm" method="post" asp-controller="Tag" asp-action="EditTag">
        <div asp-validation-summary="ModelOnly"></div>
        <div style=""><input type="hidden" asp-for="Id" value="@Model.Id" /></div>
        <div>
            <div class="mrgn">
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
        </div>
        <div class="center">
            <input class="btn_submit" type="submit" value="Сохранить" />
        </div>
        </form>
        </div>