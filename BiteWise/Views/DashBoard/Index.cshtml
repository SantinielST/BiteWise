﻿@using BiteWise.ViewModels
@using System.Security.Claims
@model DashBoardViewModel

@{
    ViewData["Title"] = "DashBoard";
}

<h1 class="display-4 fw-normal">Главная страница блога</h1>

<a class="btn btn-primary" style="text-decoration: none;" asp-area="" asp-controller="User" asp-action="MyPage">Просмотреть профиль</a>
<a class="btn btn-primary" style="text-decoration: none;" asp-controller="Article" asp-action="Create">Написать статью</a>
<a class="btn btn-primary" style="text-decoration: none;" asp-controller="Tag" asp-action="GetAllTags">Посмотреть все теги</a>

@if (User.FindAll(ClaimTypes.Role).Any(c => c.Value == "Admin"))
{
    <a class="btn btn-primary" style="text-decoration: none;" asp-controller="User" asp-action="UserList">Управление пользователями</a>
}
<br />
<div class="mrgn gray-text">
    <p style="margin-top: 30px">
        Последние вышедшие статьи:
    </p>
</div>
<div class="album py-5 bg-light">
    <div class="container">
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3">
            @foreach (var article in Model.Articles ?? throw new ArgumentNullException())
            {
                <div class="col">
                    <div class="card shadow-sm">
                        <img class="bd-placeholder-img card-img-top" src="@article.Image" width="100" height="225" alt="Card image cap" />
                        <div class="card-body">
                            <div>
                                @if (article.Tags is not null)
                                {
                                    @foreach (var tag in article.Tags)
                                    {
                                        <label style="color: black; border: groove" class="badge">@tag.Name</label>
                                    }
                                }
                            </div>
                            <p class="card-text">@article.Title</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="btn-article">
                                    <a style="text-decoration: none;" asp-controller="Article" asp-action="GetArticle" asp-route-id="@article.Id"
                                       class="btn btn-sm btn-outline-secondary">Посмотреть статью</a>
                                       <label style="margin-left: 20px;">@article.Created</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>